{
  "name": "khqr-sticker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sample": "tsx tools/sample.ts out",
    "qa:qr": "tsx tools/qr-roundtrip.ts out/qr-roundtrip.pdf && pdftoppm -png -r 150 out/qr-roundtrip.pdf out/qr && tsx tools/qr-scan.ts out/qr-1.png out/qr-2.png out/qr-3.png",
    "e2e": "npm run build && tsx tools/e2e.ts out/e2e"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.3",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svg-pathdata": "^8.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
